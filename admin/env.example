# /etc/gaafu-switch.env (chmod 600)
# Required
ADMIN_PASSWORD=change-this-to-a-long-passphrase-min-16-chars
SESSION_SECRET=paste-a-long-random-string-here-min-64-hex

# Origins/CORS
ALLOWED_ORIGIN=https://www.gaafu.tv
ALLOWED_ORIGINS=https://www.gaafu.tv,https://gaafu.tv

# Stream sources (seed values)
DIRECT_URL=https://a.gaafu.tv/hls/live.m3u8
CDN_URL=

# Proxy/trust
TRUST_PROXY=1
TRUSTED_PROXIES=127.0.0.1,::1

# Server
PORT=8787
DATA_FILE=/opt/gaafu-switch/data/state.json

# Cookies/Sessions
COOKIE_NAME=__Host-gtv
SESSION_HOURS=8
IDLE_MINUTES=30
INSECURE_COOKIE=0
