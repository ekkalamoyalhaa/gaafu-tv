{
  "name": "@sveltejs/adapter-static",
  "version": "4.0.0",
  "description": "Adapter for SvelteKit apps that prerenders your entire site as a collection of static files",
  "keywords": [
    "adapter",
    "deploy",
    "hosting",
    "ssg",
    "static site generation",
    "svelte",
    "sveltekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltejs/kit.git",
    "directory": "packages/adapter-static"
  },
  "license": "MIT",
  "homepage": "https://svelte.dev/docs/kit/adapter-static",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "platforms.js"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/kit": "^3.0.0",
    "@types/node": "^22.19.19",
    "svelte": "^5.57.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.0-next.0"
  },
  "scripts": {
    "lint": "oxfmt --check .",
    "check": "node node_modules/@typescript/native/bin/tsc",
    "format": "oxfmt --write .",
    "test": "pnpm -r --workspace-concurrency 1 --filter=\"./test/**\" test"
  }
}